DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/attendance?retryWrites=true&w=majority"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123
# face match: cosine similarity threshold (MobileFaceNet ~0.6-0.7)
FACE_THRESHOLD=0.65

# --- production (Render etc.) ---
# NODE_ENV=production
# JWT_SECRET must be 32+ random characters (the server refuses to start otherwise)
# OWNER_PASSWORD must be 10+ characters and not "owner123" (the server refuses to start otherwise)
# The built-in mock ERP is OFF in production unless you set ENABLE_MOCK_ERP=true (its demo accounts include an owner: never leave this on publicly)
# ENABLE_MOCK_ERP=false
